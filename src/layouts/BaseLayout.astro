---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ada Ball',
  description = 'Ada Ball\'s personal website',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #25251f;
    background: #faf9f6;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * { box-sizing: border-box; }
  body { margin: 0; }
  main { width: min(100% - 2rem, 720px); margin: 0 auto; padding: clamp(5rem, 15vh, 10rem) 0 5rem; }
  h1 { margin: 0 0 1.5rem; font-size: clamp(2.5rem, 8vw, 4rem); letter-spacing: -0.06em; line-height: 1; }
  p, li { color: #55554d; font-size: 1.1rem; line-height: 1.8; }
  a { color: #245c4b; text-underline-offset: 0.2em; }
  a:hover { color: #173d32; }
  hr { margin: 2.5rem 0; border: 0; border-top: 1px solid #deddd5; }
  footer { margin-top: 4rem; color: #77776f; font-size: 0.9rem; }
</style>
